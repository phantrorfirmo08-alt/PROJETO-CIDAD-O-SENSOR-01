<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SARAH NEXUS v5.2 PRO</title>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
*{box-sizing:border-box}
body{margin:0;background:#030712;color:#e5f2ff;font-family:Arial,sans-serif}
.app{min-height:100vh;background:radial-gradient(circle at 20% 10%,#063b4d55,transparent 35%),#030712}
header{padding:18px 24px;border-bottom:1px solid #00f3ff44;display:flex;justify-content:space-between;align-items:center}
.brand{color:#00f3ff;font-weight:bold;letter-spacing:3px}
.online{color:#00ff88;font-size:12px}
main{max-width:1150px;margin:auto;padding:24px;display:grid;gap:20px;grid-template-columns:290px 1fr}
.card{background:#071426dd;border:1px solid #00f3ff44;border-radius:18px;padding:20px;box-shadow:0 0 25px #00f3ff12}
.avatar{width:130px;height:130px;margin:auto;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#123b55,#24134d);border:2px solid #00f3ff;box-shadow:0 0 30px #00f3ff66}
.face{font-size:64px}
.label{color:#8ba5bd;font-size:12px;text-transform:uppercase;letter-spacing:1px}
h1,h2,p{margin-top:0}
.status{color:#00ff88}
#map{height:380px;border:1px solid #00f3ff44;border-radius:14px;overflow:hidden;background:#07111d}
.leaflet-container{background:#07111d!important}
.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.metric{padding:12px;border:1px solid #00f3ff22;border-radius:12px;background:#071426}
.value{font-size:18px;font-weight:bold;color:#00f3ff}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.btn{border:1px solid #00f3ff66;background:#00f3ff12;color:#dffcff;padding:12px 16px;border-radius:10px;cursor:pointer;display:inline-block;text-align:center}
.btn:hover{background:#00f3ff2b}
.danger{border-color:#ef444466;color:#ff9b9b}
.pulse{width:16px;height:16px;border-radius:50%;background:#ef4444;box-shadow:0 0 14px #ef4444}
video{width:100%;max-height:380px;display:block;border-radius:12px;background:#020617}
@media(max-width:850px){main{grid-template-columns:1fr;padding:14px}.metrics{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="app">
  <header>
    <div>
      <div class="brand">SARAH NEXUS</div>
      <small style="color:#8ba5bd">v5.2 PRO · DEFESA CIVIL COMUNITÁRIA</small>
    </div>
    <div class="online">● SISTEMA ONLINE</div>
  </header>

  <main>
    <!-- Painel Lateral -->
    <section class="card" style="display:flex;flex-direction:column;justify-content:space-between">
      <div>
        <div class="avatar"><div class="face">👩🏻‍💻</div></div>
        <h2 style="text-align:center;margin:18px 0 5px">SARAH</h2>
        <p style="text-align:center" class="status">Núcleo operacional ativo</p>
        <hr style="border-color:#ffffff18;margin:15px 0">
        
        <p class="label">Integridade</p>
        <strong style="color:#00ff88">98% Estável</strong>
        
        <p class="label" style="margin-top:18px">Conexão / Rota</p>
        <strong style="color:#00f3ff">Mendanha ⇄ Sebinho</strong>
      </div>

      <div style="margin-top:20px">
        <p class="label">Comando SARAH</p>
        <div class="actions" style="margin-top:8px;flex-direction:column">
          <button class="btn" onclick="falar()">🎙️ Ativar microfone</button>
          <button class="btn" onclick="alerta()">⚠️ Emitir alerta</button>
          <button class="btn danger" onclick="limpar()">Limpar registro</button>
        </div>
      </div>
    </section>

    <!-- Conteúdo Principal -->
    <div style="display:grid;gap:20px">
      
      <!-- Métricas -->
      <div class="card">
        <p class="label">Painel principal</p>
        <h1>Monitoramento tático</h1>
        <div class="metrics">
          <div class="metric"><p class="label">Temperatura</p><div class="value">28°C</div></div>
          <div class="metric"><p class="label">Umidade</p><div class="value">70%</div></div>
          <div class="metric"><p class="label">Chuva</p><div class="value">0.0 mm</div></div>
          <div class="metric"><p class="label">Vento</p><div class="value">12 km/h</div></div>
          <div class="metric"><p class="label">Direção</p><div class="value">140°</div></div>
        </div>
      </div>

      <!-- Mapa -->
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <div>
            <p class="label">Mapa tático operacional</p>
            <h2 style="margin:0">Serra do Mendanha → Sebinho</h2>
          </div>
          <span class="status">● AO VIVO</span>
        </div>
        <div id="map"></div>
      </div>

      <!-- Vídeo -->
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <div>
            <p class="label">Central visual de campo</p>
            <h2 style="margin:0">Núcleo de mídia SARAH</h2>
          </div>
        </div>

        <div style="background:#030712;padding:10px;border-radius:12px;border:1px solid #00f3ff33">
          <div id="video-placeholder" style="text-align:center;padding:30px;color:#8ba5bd">
            <div style="font-size:32px;margin-bottom:8px">▶</div>
            <p style="margin:0;font-size:14px">Selecione um vídeo da galeria do telefone</p>
          </div>
          <div id="video-container" style="display:none">
            <video id="player" controls playsinline></video>
            <div id="video-info" style="margin-top:8px;display:flex;justify-content:space-between;font-size:12px;color:#00f3ff"></div>
          </div>
        </div>

        <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
          <label class="btn" style="cursor:pointer">
            Selecionar vídeo da galeria
            <input type="file" accept="video/*" style="display:none" onchange="handleVideo(event)">
          </label>
          <button class="btn danger" id="btn-remove" style="display:none" onclick="removerVideo()">Remover vídeo</button>
        </div>
      </div>

      <!-- Log -->
      <div class="card">
        <p class="label">Log de comandos</p>
        <p id="log-text" style="margin:0;color:#9fb4c8;font-family:monospace">Sistema operacional pronto e livre de chaves.</p>
      </div>

    </div>
  </main>
</div>

<!-- Scripts Leves -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  const ORIGEM=[-22.82537,-43.49590];
  const DESTINO=[-22.78098,-43.43628];
  const CENTRO=[-22.80318,-43.46609];
  
  let map = null;
  let videoSrc = null;

  // Inicializar Mapa
  window.onload = function() {
    if(!document.getElementById('map')) return;
    
    map = L.map('map', {zoomControl:false}).setView(CENTRO, 13);
    L.control.zoom({position:"bottomleft"}).addTo(map);

    L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
      attribution:"© OpenStreetMap", subdomains:"abcd", maxZoom:19
    }).addTo(map);

    L.marker(ORIGEM).addTo(map).bindPopup("<b>ORIGEM</b><br>Serra do Mendanha");
    
    const icon = L.divIcon({className:"", html:'<div class="pulse"></div>', iconSize:[16,16]});
    L.marker(DESTINO, {icon:icon}).addTo(map).bindPopup("<b>DESTINO</b><br>Comunidade do Sebinho");

    L.polyline([ORIGEM, DESTINO], {color:"#00f3ff", weight:3, dashArray:"8 8"}).addTo(map)
     .bindPopup("Alinhamento Mendanha → Sebinho");

    L.circle(DESTINO, {radius:3000, color:"#00ff88", fillColor:"#00f3ff", fillOpacity:.08}).addTo(map);
  };

  // Funções dos Botões
  function falar(){
    document.getElementById('log-text').innerText = "Microfone ativado. Aguardando comando de voz...";
    if("speechSynthesis" in window) speechSynthesis.speak(new SpeechSynthesisUtterance("Microfone ativado."));
  }

  function alerta(){
    document.getElementById('log-text').innerText = "Alerta registrado no painel tático.";
  }

  function limpar(){
    document.getElementById('log-text').innerText = "Registro limpo.";
  }

  function handleVideo(e){
    const file = e.target.files[0];
    if(!file) return;
    
    if(videoSrc) URL.revokeObjectURL(videoSrc);
    videoSrc = URL.createObjectURL(file);
    
    const player = document.getElementById('player');
    player.src = videoSrc;
    
    document.getElementById('video-placeholder').style.display = 'none';
    document.getElementById('video-container').style.display = 'block';
    document.getElementById('btn-remove').stylestyle.display = 'inline-block';

    document.getElementById('video-info').innerHTML = 
      '<span>'+file.name+'</span><span style="color:#8ba5bd">'+(file.size/1024/1024).toFixed(2)+' MB</span>';
    
    document.getElementById('log-text').innerText = "Vídeo carregado.";
  }

  function removerVideo(){
    if(videoSrc) URL.revokeObjectURL(videoSrc);
    videoSrc = null;
    
    const player = document.getElementById('player');
    player.pause();
    player.removeAttribute('src');
    player.load();
    
    document.getElementById('video-placeholder').style.display = 'block';
    document.getElementById('video-container').style.display = 'none';
    document.getElementById('btn-remove').style.display = 'none';
    document.getElementById('video-info').innerHTML = '';
    document.querySelector('input[type=file]').value = '';
    
    document.getElementById('log-text').innerText = "Vídeo removido.";
  }
</script>
</body>
</html>
