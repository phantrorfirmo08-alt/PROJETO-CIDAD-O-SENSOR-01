<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SARAH AI Core v4.0 - Sebinho</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="manifest" href="manifest.json">
<style>body{background:#020617;color:#e2e8f0}</style>
</head>
<body>
<div id="root"></div>

<script type="module">
import React, {useState, useEffect, useRef} from "https://esm.sh/react@18.2.0";
import ReactDOM from "https://esm.sh/react-dom@18.2.0/client";

const agente = { model: "llama-3.3-70b-versatile", temp: 0.2 };

function App(){
 const [dark,setDark]=useState(true);
 const [font,setFont]=useState(1);
 const [weather,setWeather]=useState(null);
 const [msgs,setMsgs]=useState([{sender:'sarah', text:'Sistema SARAH pronto. Monitoramento: Comunidade do Sebinho (linha férrea até Via Light) - Confluência Dona Eugênia no Sarapuí - Ponte Frigo Eden. Pode perguntar qualquer rua do Sebinho.'}]);
 const [input,setInput]=useState('');
 const [loading,setLoading]=useState(false);
 const [hasGreeted,setHasGreeted]=useState(false);
 const [deferred,setDeferred]=useState(null);

 useEffect(()=>{
   window.addEventListener('beforeinstallprompt', e=>{ e.preventDefault(); setDeferred(e); });
   fetch('https://api.open-meteo.com/v1/forecast?latitude=-22.7845&longitude=-43.4140&current=temperature_2m,precipitation,wind_speed_10m&timezone=America/Sao_Paulo')
  .then(r=>r.json()).then(d=>setWeather(d.current)).catch(()=>{});
 },[]);

 const install = async ()=>{
   if(deferred){ deferred.prompt(); await deferred.userChoice; setDeferred(null); }
   else alert("Menu do navegador > Adicionar à tela inicial");
 };
 const share = async ()=>{
   if(navigator.share){ try{ await navigator.share({title:'SARAH Sebinho', url: location.href}); }catch{} }
   else { navigator.clipboard.writeText(location.href); alert("Link copiado!"); }
 };

 const send = async ()=>{
   if(!input.trim()) return;
   const now = new Date();
   const hora = parseInt(new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Sao_Paulo', hour:'numeric', hour12:false}).format(now));
   const saud = hora>=5&&hora<12?"Bom dia": hora<18?"Boa tarde": hora<23?"Boa noite":"Boa madrugada";
   const userMsg = {sender:'user', text: input};
   setMsgs(m=>[...m, userMsg]);
   const txt = input;
   setInput(''); setLoading(true);
   try{
     const resp = await fetch("/api/sarah",{
       method:"POST", headers:{"Content-Type":"application/json"},
       body: JSON.stringify({ hasGreeted, saudacao: saud, weather: weather? `Chuva ${weather.precipitation}mm Vento ${weather.wind_speed_10m}km/h` : "sem dados", historico: msgs.slice(-6), mensagem: txt, model: agente.model, temperature: agente.temp })
     });
     const data = await resp.json();
     setMsgs(m=>[...m, {sender:'sarah', text: data.resposta || "Sebinho OK - satélite atualizado"}]);
     setHasGreeted(true);
   }catch(e){
     setMsgs(m=>[...m, {sender:'sarah', text:"Erro: GROQ_API_KEY não está no cofre do Cloudflare. Coloque em Settings > Variables > Encrypt"}]);
   }
   setLoading(false);
 };

 const fs = ["text-xs","text-sm","text-base","text-lg"][font];

 return React.createElement("div",{className:`min-h-screen bg-slate-950 p-3 ${fs}`},
  React.createElement("header",{className:"flex flex-wrap justify-between gap-2 border-b border-cyan-500/30 pb-3"},
   React.createElement("div",{className:"font-mono text-[11px] text-cyan-400 font-bold"},`SARAH v4.0 - Sebinho / Frigo Eden - ${agente.model}`),
   React.createElement("div",{className:"flex gap-1.5 flex-wrap"},
     React.createElement("button",{onClick:install, className:"px-3 py-1.5 bg-cyan-500 text-black font-bold rounded text-xs"},"📲 Instalar"),
     React.createElement("button",{onClick:share, className:"px-3 py-1.5 bg-slate-800 border border-cyan-500/30 rounded text-xs"},"🔗 Compartilhar"),
     React.createElement("button",{onClick:()=>setFont(f=>Math.max(0,f-1)), className:"px-2 py-1.5 bg-slate-800 rounded text-xs"},"A-"),
     React.createElement("button",{onClick:()=>setFont(f=>Math.min(3,f+1)), className:"px-2 py-1.5 bg-slate-800 rounded text-xs"},"A+"),
     React.createElement("button",{onClick:()=>setDark(!dark), className:"px-2 py-1.5 bg-slate-800 rounded text-xs"},"🌗 Dia/Noite")
   )
  ),
  weather && React.createElement("div",{className:"mt-3 bg-slate-900 border border-cyan-500/20 rounded p-2 font-mono text-[11px] flex gap-4"},
    `🌧️ ${weather.precipitation}mm 💨 ${weather.wind_speed_10m}km/h 🌡️ ${weather.temperature_2m}°C 📍 Confluência Dona Eugênia / Sarapuí`
  ),
  React.createElement("div",{className:"mt-3 space-y-2"},
    msgs.map((m,i)=> React.createElement("div",{key:i, className:`p-3 rounded ${m.sender=='user'?'bg-cyan-900/30 ml-6':'bg-slate-800 mr-6'}`}, m.text)),
    loading && React.createElement("div",{className:"text-xs animate-pulse"},"Sara analisando satélite...")
  ),
  React.createElement("div",{className:"mt-4 flex gap-2"},
    React.createElement("input",{value:input, onChange:e=>setInput(e.target.value), onKeyDown:e=>e.key=='Enter'&&send(), placeholder:"Pergunte qualquer rua no Sebinho...", className:"flex-1 bg-black border border-cyan-500/40 rounded px-3 py-2 text-sm"}),
    React.createElement("button",{onClick:send, className:"px-4 py-2 bg-cyan-500 text-black font-bold rounded text-sm"},"Enviar")
  )
 );
}

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
</script>
</body>
</html>
