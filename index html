        // Tab Switching
        function switchTab(tabId) {
            const tabs = ['comando', 'gade', 'rotas', 'radar', 'balanca', 'sarah'];
            tabs.forEach(t => {
                const el = document.getElementById('content-' + t);
                const btn = document.getElementById('tab-' + t);
                if (t === tabId) {
                    el.classList.remove('hidden');
                    if(btn) {
                        btn.className = 'px-4 py-2 rounded-lg font-semibold bg-emerald-600 text-white flex items-center space-x-2 transition-all shrink-0';
                    }
                } else {
                    el.classList.add('hidden');
                    if(btn) {
                        btn.className = 'px-4 py-2 rounded-lg font-semibold text-slate-400 hover:bg-slate-800 hover:text-slate-200 flex items-center space-x-2 transition-all shrink-0';
                    }
                }
            });
            if(tabId === 'comando') {
                setTimeout(() => { map.invalidateSize(); }, 200);
            }
        }

        // Theme Toggle
        let isWarm = false;
        function toggleTheme() {
            isWarm = !isWarm;
            document.body.classList.toggle('theme-warm', isWarm);
        }

        // Leaflet Map Initialization
        let map = L.map('tactical-map').setView([-22.785, -43.432], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        L.marker([-22.785, -43.432]).addTo(map)
            .bindPopup('<b>Comunidade do Sebinho</b><br>Mesquita - RJ<br>Estação GADE / A Chave da Esperança')
            .openPopup();

        // SOS Generator
        function captureGPSAndGenerateSOS() {
            const name = document.getElementById('sos-name').value || 'Morador Voluntário';
            const type = document.getElementById('sos-type').value;
            
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(position => {
                    const lat = position.coords.latitude.toFixed(6);
                    const lon = position.coords.longitude.toFixed(6);
                    const msg = `[ALERTA SOS - DEFESA CIVIL / GADE]\nMorador: ${name}\nOcorrência: ${type}\nLocalização GPS: Lat ${lat}, Lon ${lon}\nComunidade do Sebinho, Mesquita - RJ. Ajuda urgente necessária!`;
                    const out = document.getElementById('sos-output-container');
                    out.classList.remove('hidden');
                    out.innerText = msg;
                }, error => {
                    alert('Erro ao capturar GPS. Verifique permissões do navegador.');
                });
            } else {
                alert('Geolocalização não suportada neste navegador.');
            }
        }

        function copySOSMessage() {
            const out = document.getElementById('sos-output-container');
            if (out.classList.contains('hidden') || !out.innerText) {
                alert('Gere o SOS com GPS primeiro.');
                return;
            }
            navigator.clipboard.writeText(out.innerText);
            alert('Mensagem SOS copiada para a área de transferência!');
        }

        // Weather Telemetry (Open-Meteo)
        async function fetchMunicipalityWeather() {
            const val = document.getElementById('municipality-select').value.split(',');
            const lat = val[0];
            const lon = val[1];
            try {
                const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m`);
                const data = await res.json();
                document.getElementById('w-temp').innerText = data.current.temperature_2m + ' °C';
                document.getElementById('w-precip').innerText = data.current.precipitation + ' mm';
                document.getElementById('w-humidity').innerText = data.current.relative_humidity_2m + ' %';
                document.getElementById('w-wind').innerText = data.current.wind_speed_10m + ' km/h';
            } catch (e) {
                console.error(e);
            }
        }
        fetchMunicipalityWeather();

        // ESG Balança
        let totalWeight = 0;
        let totalWater = 0;
        let totalCo2 = 0;

        function registerESGWeight() {
            const mat = document.getElementById('esg-material').value;
            const w = parseFloat(document.getElementById('esg-weight').value) || 0;
            if (w <= 0) {
                alert('Insira um peso válido.');
                return;
            }
            totalWeight += w;
            totalWater += w * 4.5;
            totalCo2 += w * 1.8;

            document.getElementById('esg-total-weight').innerText = totalWeight.toFixed(1) + ' kg';
            document.getElementById('esg-water').innerText = totalWater.toFixed(0) + ' litros';
            document.getElementById('esg-co2').innerText = totalCo2.toFixed(1) + ' kg';
            alert('Pesagem registrada com sucesso no sistema ESG!');
        }

        // Sarah AI Speech & Supervisor
        function speakSarahWelcome() {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance("Sarah AI Nexus ativada. Monitorando os 92 municípios do Rio de Janeiro. Nível do Rio Sarapuí estável em 1.42 metros. Defesa Civil em alerta.");
                utterance.lang = 'pt-BR';
                window.speechSynthesis.speak(utterance);
            } else {
                alert('Síntese de voz não suportada neste navegador.');
            }
        }

        function sendSarahCommand() {
            const input = document.getElementById('sarah-input');
            const log = document.getElementById('sarah-chat-log');
            const txt = input.value.trim();
            if(!txt) return;

            log.innerHTML += `<div class="text-slate-300">> ${txt}</div>`;
            input.value = '';

            setTimeout(() => {
                let reply = "Comando processado com sucesso pelo núcleo tático da Sarah AI Nexus.";
                if(txt.toLowerCase().includes('sarapuí') || txt.toLowerCase().includes('nivel')) {
                    reply = "Nível atual do Rio Sarapuí: 1.42 metros. Sem riscos iminentes de transbordamento nas últimas 2 horas.";
                } else if(txt.toLowerCase().includes('mesquita') || txt.toLowerCase().includes('sebinho')) {
                    reply = "Comunidade do Sebinho em Mesquita: Status operacional verde. Coordenador Alexander Firmo registrado.";
                }
                log.innerHTML += `<div class="text-emerald-400">[SARAH AI]: ${reply}</div>`;
                log.scrollTop = log.scrollHeight;
                
                if ('speechSynthesis' in window) {
                    const u = new SpeechSynthesisUtterance(reply);
                    u.lang = 'pt-BR';
                    window.speechSynthesis.speak(u);
                }
            }, 500);
        }
    </script>
