<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#030712">
<title>SARAH NEXUS v5.0 — Defesa Civil Comunitária</title>

<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://unpkg.com">
<link rel="preconnect" href="https://tilecache.rainviewer.com">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
tailwind.config = {
  darkMode: "class",
  theme: {
    extend: {
      colors: {
        nexusCyan: "#00f3ff",
        nexusGreen: "#00ff88",
        nexusBlue: "#071a33",
        nexusViolet: "#8b5cf6"
      },
      fontFamily: {
        sans: ["Inter","system-ui","sans-serif"],
        mono: ["JetBrains Mono","Consolas","monospace"]
      }
    }
  }
};
</script>

<style>
:root{
  --bg:#030712;
  --panel:#071426;
  --panel2:#0b1d35;
  --cyan:#00f3ff;
  --green:#00ff88;
  --violet:#8b5cf6;
  --text:#e5f2ff;
}
*{box-sizing:border-box}
html,body,#root{min-height:100%;margin:0}
body{
  overflow-x:hidden;
  background:var(--bg);
  color:var(--text);
  font-family:Inter,system-ui,sans-serif;
}
.glass-dark{
  background:rgba(7,20,38,.9);
  border:1px solid rgba(0,243,255,.32);
  box-shadow:0 12px 40px rgba(0,0,0,.42);
  backdrop-filter:blur(18px);
}
.leaflet-container{
  z-index:1;
  min-height:390px;
  background:#020812!important;
}
.leaflet-control-layers,
.leaflet-control-zoom a{
  background:#071426!important;
  color:#00f3ff!important;
  border-color:#00f3ff55!important;
}
.leaflet-popup-content-wrapper,
.leaflet-popup-tip{
  background:#071426;
  color:#e5f2ff;
}
.leaflet-popup-content-wrapper{
  border:1px solid #00ff88aa;
}
.nexus-map{
  position:relative;
  min-height:390px;
  overflow:hidden;
  border:1px solid #00f3ff66;
  border-radius:16px;
}
.nexus-hud{
  position:absolute;
  z-index:500;
  top:14px;
  left:14px;
  padding:8px 12px;
  border:1px solid #00f3ff66;
  border-radius:10px;
  background:#030712dd;
  color:#00ff88;
  font:11px "JetBrains Mono",monospace;
  letter-spacing:.08em;
  pointer-events:none;
}
.nexus-pulse{
  width:16px;
  height:16px;
  border-radius:50%;
  background:#ff405c;
  border:2px solid #fff;
  box-shadow:0 0 12px #ff405c,0 0 28px #ff405c;
  animation:nexusPulse 1.6s infinite;
}
@keyframes nexusPulse{
  0%,100%{transform:scale(.8);opacity:.8}
  50%{transform:scale(1.25);opacity:1}
}
.nexus-avatar{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  border:2px solid var(--cyan);
  border-radius:32%;
  background:radial-gradient(circle at 50% 35%,#173d5b 0 12%,transparent 13%),linear-gradient(145deg,#020812,#092844 55%,#063b35);
  box-shadow:0 0 24px #00f3ff66, inset 0 0 25px #00ff8833;
}
.nexus-face{
  position:relative;
  width:70%;
  height:70%;
  border:2px solid #65eaff;
  border-radius:48% 48% 42% 42%;
  background:linear-gradient(160deg,#b9f7ff,#4cc9f0 45%,#123b62);
}
.nexus-eye{
  position:absolute;
  top:43%;
  width:18%;
  height:10%;
  border-radius:50%;
  background:#fff;
  box-shadow:0 0 9px #00f3ff;
}
.nexus-eye.left{left:22%}
.nexus-eye.right{right:22%}
.nexus-mouth{
  position:absolute;
  left:38%;
  bottom:22%;
  width:24%;
  height:8%;
  border-bottom:2px solid #00f3ff;
  border-radius:50%;
}
video{width:100%;max-height:400px;display:block;border-radius:12px;background:#020617}
</style>
</head>

<body>
<div id="root"></div>

<script type="text/babel">
const {useEffect,useRef,useState,useCallback}=React;

const ORIGEM=[-22.82537,-43.49590];
const DESTINO=[-22.78098,-43.43628];
const CENTRO=[-22.80318,-43.46609];
const TZ="America/Sao_Paulo";

const fmtTime=()=>new Intl.DateTimeFormat("pt-BR",{
 timeZone:TZ,hour:"2-digit",minute:"2-digit",second:"2-digit"
}).format(new Date());

function SarahAvatar({large=false}){
  return (
    <div className={`${large?"w-24 h-24":"w-12 h-12"} nexus-avatar`}>
      <div className="nexus-face">
        <span className="nexus-eye left"></span>
        <span className="nexus-eye right"></span>
        <span className="nexus-mouth"></span>
      </div>
    </div>
  );
}

function Card({title,value,unit=""}){
  return (
    <div className="rounded-xl border border-cyan-400/20 bg-[#071426] p-3">
      <div className="text-[10px] uppercase tracking-wider text-slate-400">{title}</div>
      <strong className="text-lg text-cyan-300">{value}{unit}</strong>
    </div>
  );
}

// Componente da Central de Mídia (Upload de Vídeos da Galeria)
function MediaCenter(){
  const [videoSrc,setVideoSrc]=useState(null);
  const [videoInfo,setVideoInfo]=useState(null);
  const [statusMsg,setStatusMsg]=useState("Nenhum vídeo selecionado");
  const [statusType,setStatusType]=useState("normal");
  const videoRef=useRef(null);

  const handleFileChange=(e)=>{
    const file=e.target.files[0];
    if(!file)return;

    if(!file.type.startsWith("video/")){
      setStatusMsg("Selecione um arquivo de vídeo válido");
      setStatusType("error");
      return;
    }

    if(videoSrc)URL.revokeObjectURL(videoSrc);

    const url=URL.createObjectURL(file);
    setVideoSrc(url);
    setStatusMsg("Vídeo carregado da galeria");
    setStatusType("ok");

    const sizeMB=(file.size/1024/1024).toFixed(2)+" MB";
    setVideoInfo({name:file.name,size:sizeMB});
  };

  const handleRemove=()=>{
    if(videoSrc)URL.revokeObjectURL(videoSrc);
    setVideoSrc(null);
    setVideoInfo(null);
    setStatusMsg("Nenhum vídeo selecionado");
    setStatusType("normal");
  };

  return (
    <section className="glass-dark mb-5 rounded-2xl p-4 sm:p-5">
      <div className="mb-4 flex flex-wrap items-center justify-between gap-2">
        <div>
          <p className="text-[10px] uppercase tracking-[.25em] text-cyan-300">Central visual</p>
          <h2 className="text-lg font-semibold text-white">Núcleo de mídia SARAH</h2>
        </div>
        <span className={`text-xs ${statusType==="error"?"text-red-300":statusType==="ok"?"text-emerald-300":"text-slate-400"}`}>
          {statusMsg}
        </span>
      </div>

      <div className="rounded-xl border border-cyan-400/30 bg-black/40 p-2">
        {!videoSrc?(
          <div className="flex min-h-[190px] flex-col items-center justify-center text-center text-slate-400">
            <div className="mb-2 text-3xl text-cyan-400">▶</div>
            <p className="text-sm">Selecione um vídeo da galeria do telefone</p>
            <p className="mt-1 text-xs text-slate-500">O arquivo permanece armazenado no seu dispositivo</p>
          </div>
        ):(
          <video ref={videoRef} src={videoSrc} controls playsinline className="mx-auto"></video>
        )}
      </div>

      {videoInfo&&(
        <div className="mt-3 rounded-lg border border-cyan-400/20 bg-black/30 p-3 text-xs flex flex-wrap justify-between gap-2">
          <span className="truncate text-cyan-200">{videoInfo.name}</span>
          <span className="text-slate-400">{videoInfo.size}</span>
        </div>
      )}

      <div className="mt-4 flex flex-wrap gap-2">
        <label className="cursor-pointer rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-300">
          {videoSrc?"Trocar vídeo":"Selecionar vídeo da galeria"}
          <input type="file" accept="video/*" className="hidden" onChange={handleFileChange}/>
        </label>

        {videoSrc&&(
          <button onClick={handleRemove} className="rounded-lg border border-red-400/50 px-4 py-2 text-sm text-red-300 hover:bg-red-400/10">
            Remover vídeo
          </button>
        )}
      </div>
    </section>
  );
}

// Componente do Mapa e Clima
function NexusMapPanel(){
  const mapRef=useRef(null);
  const mapInstance=useRef(null);
  const [weather,setWeather]=useState(null);
  const [loading,setLoading]=useState(true);
  const [clock,setClock]=useState(fmtTime());

  useEffect(()=>{
    const t=setInterval(()=>setClock(fmtTime()),1000);
    return()=>clearInterval(t);
  },[]);

  const loadWeather=useCallback(()=>{
    setLoading(true);
    const params=new URLSearchParams({
      latitude:CENTRO[0],
      longitude:CENTRO[1],
      current:"temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m,wind_direction_10m",
      timezone:TZ
    });

    fetch("https://api.open-meteo.com/v1/forecast?"+params)
      .then(r=>r.json())
      .then(d=>{if(d?.current)setWeather(d.current);})
      .catch(()=>setWeather(null))
      .finally(()=>setLoading(false));
  },[]);

  useEffect(()=>{
    loadWeather();
    const t=setInterval(loadWeather,600000);
    return()=>clearInterval(t);
  },[loadWeather]);

  useEffect(()=>{
    if(!mapRef.current||mapInstance.current)return;
    const m=L.map(mapRef.current,{zoomControl:false}).setView(CENTRO,12);
    mapInstance.current=m;
    L.control.zoom({position:"bottomleft"}).addTo(m);

    L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",{
      attribution:"© OpenStreetMap © CARTO",subdomains:"abcd",maxZoom:19
    }).addTo(m);

    L.marker(ORIGEM).addTo(m).bindPopup("<b>ORIGEM</b><br>Serra do Mendanha");
    
    const icon=L.divIcon({className:"",html:'<div class="nexus-pulse"></div>',iconSize:[16,16]});
    L.marker(DESTINO,{icon}).addTo(m).bindPopup("<b>DESTINO</b><br>Comunidade do Sebinho");

    L.polyline([ORIGEM,DESTINO],{color:"#00f3ff",weight:3,dashArray:"8 8"}).addTo(m)
     .bindPopup("Alinhamento Mendanha → Sebinho");

    L.circle(DESTINO,{radius:4000,color:"#00ff88",fillColor:"#00f3ff",fillOpacity:.08}).addTo(m);
  },[]);

  return(
    <section className="glass-dark rounded-2xl p-4 shadow-2xl">
      <div className="mb-3 flex items-center justify-between">
        <h2 className="text-base font-semibold text-cyan-300">Mapa operacional & Telemetria</h2>
        <span className="text-xs text-emerald-300 font-mono">{clock}</span>
      </div>

      <div className="nexus-map">
        <div ref={mapRef} id="map" className="h-[390px] w-full rounded-xl"></div>
        <div className="nexus-hud font-mono">{loading?"SINCRONIZANDO...":"ONLINE"}</div>
      </div>

      <div className="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-5">
        <Card title="Temperatura" value={weather?Math.round(weather.temperature_2m):"--"} unit="°C"/>
        <Card title="Umidade" value={weather?Math.round(weather.relative_humidity_2m):"--"} unit="%"/>
        <Card title="Chuva" value={weather?Number(weather.precipitation||0).toFixed(1):"--"} unit=" mm"/>
        <Card title="Vento" value={weather?Math.round(weather.wind_speed_10m):"--"} unit=" km/h"/>
        <Card title="Direção" value={weather?Math.round(weather.wind_direction_10m||0):"--"} unit="°"/>
      </div>

      <div className="mt-3 flex flex-wrap items-center justify-between gap-2">
        <span className="text-xs text-slate-400">
          {loading?"Atualizando Open-Meteo...":weather?"Dados atualizados":"Fonte temporariamente indisponível"}
        </span>
        <button onClick={loadWeather} className="rounded-lg border border-cyan-400/40 px-4 py-2 text-xs text-cyan-300 hover:bg-cyan-400/10">
          Atualizar dados
        </button>
      </div>

      <div className="mt-3 rounded-lg border border-amber-400/20 bg-amber-400/5 p-3 text-xs text-slate-300">
        <b className="text-amber-300">IA operacional:</b> os dados são informativos e não substituem alertas oficiais da Defesa Civil, INMET ou CEMADEN.
      </div>
    </section>
  );
}

function NexusApp(){
  return(
    <main className="mx-auto min-h-screen max-w-5xl p-4 sm:p-8">
      <header className="mb-6 flex flex-col items-center text-center">
        <SarahAvatar large/>
        <h1 className="mt-3 text-xl font-bold tracking-wide text-cyan-300">
          SARAH IA NEXUS V5.0
        </h1>
        <p className="mt-1 text-sm text-slate-400">
          Monitoramento inteligente & Central de mídia comunitária
        </p>
      </header>

      <MediaCenter/>
      <NexusMapPanel/>

      <footer className="mt-6 border-t border-cyan-400/20 py-4 text-center text-xs text-slate-500">
        Open-Meteo · OpenStreetMap · CARTO · SARAH IA NEXUS V5.0
      </footer>
    </main>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<NexusApp/>);

if("serviceWorker" in navigator){
  window.addEventListener("load",()=>{
    navigator.serviceWorker.register("./sw.js").catch(err=>console.warn("SW erro:",err));
  });
}
</script>
</body>
</html>
