<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Inter:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
 body { background: #04060A; color: #F1F5F9; font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
 .mono { font-family: 'JetBrains Mono', monospace; }
 .glass { background: rgba(9, 14, 25, 0.96); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.15); }
 .glass-card { background: rgba(14, 21, 37, 0.92); border: 1px solid rgba(255, 255, 255, 0.12); }
 
 .btn-touch { min-height: 50px; display: flex; align-items: center; justify-content: center; font-weight: 800; cursor: pointer; transition: transform 0.1s ease, background-color 0.15s ease; }
 .btn-touch:active { transform: scale(0.97); }
 
 .input-pro { background: #070A14; border: 1px solid rgba(255, 255, 255, 0.3); color: #FFF; font-size: 16px; font-weight: 700; min-height: 48px; padding: 0 14px; }
 .input-pro:focus { border-color: #3B82F6; outline: none; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.4); }

 .speed-normal { animation: radarPulse 2.5s infinite; }
 .speed-media { animation: radarPulse 1.4s infinite; }
 .speed-avancada { animation: radarPulse 0.7s infinite; }

 @keyframes radarPulse { 
   0% { r: 10px; opacity: 0.9; } 
   70% { r: 60px; opacity: 0; } 
   100% { r: 10px; opacity: 0; } 
 }
</style>
