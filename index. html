<script>
const MUNICIPIOS_RJ_92 = [
 "Mesquita (Base Oficial - Rocha Sobrinho)", "Nova Iguaçu", "Duque de Caxias", "São João de Meriti", "Belford Roxo", "Nilópolis", "São Gonçalo", "Niterói", "Petrópolis", "Angra dos Reis", "Aperibé", "Araruama", "Areal", "Armação dos Búzios", "Arraial do Cabo", "Barra do Piraí", "Barra Mansa", "Bom Jardim", "Bom Jesus do Itabapoana", "Cabo Frio", "Cachoeiras de Macacu", "Cambuci", "Campos dos Goytacazes", "Cantagalo", "Carapebus", "Cardoso Moreira", "Carmo", "Casimiro de Abreu", "Comendador Levy Gasparian", "Conceição de Macabu", "Cordeiro", "Duas Barras", "Engenheiro Paulo de Frontin", "Guapimirim", "Iguaba Grande", "Itaboraí", "Itaguaí", "Italva", "Itaocara", "Itaperuna", "Itatiaia", "Japeri", "Laje do Muriaé", "Macaé", "Macuco", "Magé", "Mangaratiba", "Maricá", "Mendes", "Miguel Pereira", "Miracema", "Natividade", "Nova Friburgo", "Paracambi", "Paraíba do Sul", "Paraty", "Paty do Alferes", "Pinheiral", "Piraí", "Porciúncula", "Porto Real", "Quatis", "Queimados", "Quissamã", "Resende", "Rio Bonito", "Rio Claro", "Rio das Flores", "Rio das Ostras", "Rio de Janeiro (Capital)", "Santa Maria Madalena", "Santo Antônio de Pádua", "São Fidélis", "São Francisco de Itabapoana", "São João da Barra", "São José de Ubá", "São José do Vale do Rio Preto", "São Pedro da Aldeia", "São Sebastião do Alto", "Sapucaia", "Saquarema", "Seropédica", "Silva Jardim", "Sumidouro", "Tanguá", "Teresópolis", "Trajano de Moraes", "Três Rios", "Valença", "Varre-Sai", "Vassouras", "Volta Redonda"
];

let streamAtivo = null;
let fotosArray = [];
let coordenadasGPS = "Lat: -22.7858, Lon: -43.4294";

window.onload = function() {
  const sel = document.getElementById('selMun');
  MUNICIPIOS_RJ_92.forEach(m => {
    let opt = document.createElement('option');
    opt.value = m;
    opt.textContent = m;
    sel.appendChild(opt);
  });

  setInterval(atualizarRelogioBrasilia, 1000);
  atualizarRelogioBrasilia();
  calcularTempoChegada();
};

function atualizarRelogioBrasilia() {
  const agora = new Date();
  const options = { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
  document.getElementById('relogioBrasilia').textContent = new Intl.DateTimeFormat('pt-BR', options).format(agora);
}

function zerarSistema() {
  if (confirm('Deseja zerar o painel de alerta antecipado?')) {
    document.getElementById('txtRelato').value = '';
    fotosArray = [];
    renderFotos();
    if (streamAtivo) toggleCamera();
    alert('Sistema limpo para nova vistoria.');
  }
}

function alternarTelaCheia() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(err => {});
  } else {
    if (document.exitFullscreen) document.exitFullscreen();
  }
}

function calcularTempoChegada() {
  // Simulação do motor preditivo cruzando as serras
  const tempos = ["1h 15min", "1h 35min", "45 minutos", "2h 10min"];
  const tempoEscolhido = tempos[Math.floor(Math.random() * tempos.length)];
  document.getElementById('txtETA').textContent = tempoEscolhido;
  document.getElementById('txtStatusPreditivo').textContent = "Fluxo cruzado Serra do Mar + Mendanha ativo. Água estimada batendo na comunidade em " + tempoEscolhido + ".";
}

function mudarVelocidade(nivel) {
  const ring = document.getElementById('radarRingElement');
  const btnN = document.getElementById('btnNormal');
  const btnM = document.getElementById('btnMedia');
  const btnA = document.getElementById('btnAvancada');

  btnN.className = "btn-touch px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300";
  btnM.className = "btn-touch px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300";
  btnA.className = "btn-touch px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300";

  ring.className = "";

  if (nivel === 'normal') {
    ring.classList.add('speed-normal');
    btnN.className = "btn-touch px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white";
  } else if (nivel === 'media') {
    ring.classList.add('speed-media');
    btnM.className = "btn-touch px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 text-black";
  } else if (nivel === 'avancada') {
    ring.classList.add('speed-avancada');
    btnA.className = "btn-touch px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-600 text-white";
  }
}

function atualizarAlvo() {
  const m = document.getElementById('selMun').value;
  document.getElementById('lblAlvo').textContent = "ALVO: " + m;
}

async function toggleCamera() {
  const video = document.getElementById('videoElement');
  const ph = document.getElementById('camPlaceholder');
  const btnT = document.getElementById('btnCamToggle');
  const btnC = document.getElementById('btnCapturar');

  if (!streamAtivo) {
    try {
      streamAtivo = await navigator.mediaDevices.getUserMedia({ 
        video: { facingMode: { ideal: "environment" }, width: { ideal: 1280 }, height: { ideal: 720 } },
        audio: false 
      });
      video.srcObject = streamAtivo;
      video.setAttribute('playsinline', true);
      video.style.display = 'block';
      ph.style.display = 'none';
      btnC.style.display = 'block';
      btnT.textContent = 'DESLIGAR';
      btnT.className = 'btn-touch px-5 py-2.5 bg-rose-500/20 text-rose-300 rounded-xl text-xs sm:text-sm';
    } catch (e) {
      alert('ERRO DE CÂMERA: PERMISSÃO NEGADA OU HTTPS NECESSÁRIO.');
    }
  } else {
    streamAtivo.getTracks().forEach(t => t.stop());
    streamAtivo = null;
    video.srcObject = null;
    video.style.display = 'none';
    ph.style.display = 'flex';
    btnC.style.display = 'none';
    btnT.textContent = 'LIGAR CÂMERA';
    btnT.className = 'btn-touch px-5 py-2.5 bg-blue-600 text-white rounded-xl text-xs sm:text-sm';
  }
}

function capturarFoto() {
  const video = document.getElementById('videoElement');
  if (video.videoWidth === 0) return;

  const c = document.createElement('canvas');
  c.width = 900;
  c.height = Math.round(900 * (video.videoHeight / video.videoWidth));
  const ctx = c.getContext('2d');
  ctx.drawImage(video, 0, 0, c.width, c.height);

  ctx.fillStyle = 'rgba(4, 6, 10, 0.95)';
  ctx.fillRect(0, 0, c.width, 48);
  ctx.fillRect(0, c.height - 68, c.width, 68);

  ctx.fillStyle = '#3B82F6';
  ctx.font = '800 16px monospace';
  ctx.fillText('SARAH AI // ALERTA ANTECIPADO SEBINHO', 18, 30);

  ctx.fillStyle = '#FFFFFF';
  ctx.font = '700 14px monospace';
  const mun = document.getElementById('selMun').value;
  const eta = document.getElementById('txtETA').textContent;
  const relogioBsb = document.getElementById('relogioBrasilia').textContent;
  ctx.fillText(relogioBsb + ' (BR) | ' + mun, 18, c.height - 40);
  ctx.fillText('ETA ENXURRADA: ' + eta + ' | RESP: ' + document.getElementById('txtNome').value, 18, c.height - 18);

  fotosArray.push(c.toDataURL('image/jpeg', 0.90));
  renderFotos();
}

function renderFotos() {
  const gal = document.getElementById('galeriaFotos');
  gal.innerHTML = '';
  fotosArray.forEach((f, idx) => {
    let div = document.createElement('div');
    div.className = 'relative shrink-0';
    div.innerHTML = `<img src="${f}" class="w-24 h-24 object-cover rounded-xl border border-white/30 shadow-md" /><button onclick="removerFoto(${idx})" class="btn-touch absolute -top-1.5 -right-1.5 w-7 h-7 bg-rose-600 text-white rounded-full text-xs font-black shadow">×</button>`;
    gal.appendChild(div);
  });
}

function removerFoto(i) {
  fotosArray.splice(i, 1);
  renderFotos();
}

function enviarWhatsapp() {
  const nome = document.getElementById('txtNome').value;
  const bairro = document.getElementById('txtBairro').value;
  const mun = document.getElementById('selMun').value;
  const risco = document.getElementById('selRisco').value;
  const eta = document.getElementById('txtETA').textContent;
  const relogioBsb = document.getElementById('relogioBrasilia').textContent;
  const relato = document.getElementById('txtRelato').value;

  if (!nome || !bairro) { alert('PREENCHA RESPONSÁVEL E BASE'); return; }
  if (fotosArray.length === 0) { alert('CAPTURE AO MENOS 1 FOTO'); return; }

  const texto = `*🚨 SARAH AI // ALERTA ANTECIPADO DE ENXURRADA*\n*HORA (BR):* ${relogioBsb}\n*LOCAL:* ${mun} - ${bairro}\n*ETA (TEMPO DE CHEGADA):* ⏱️ *${eta}*\n*RISCO:* ${risco}\n*AVISO:* ${relato}\n*RESP:* ${nome}`;
  window.open(`https://wa.me/?text=${encodeURIComponent(texto)}`, '_blank');
}
</script>
