<body class="min-h-screen">
<div id="app" class="max-w-[480px] mx-auto p-4 pb-24 space-y-5"></div>

<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

<script type="text/babel">

// === OBSERVATÓRIO COM CONTATO CORRIGIDO - SÓ NÚMERO ===
function AutomatedObservatoryWidget(){
    const lastCheck = new Date().toLocaleTimeString('pt-BR');
    return(
        <div className="relative rounded-[32px] p-[1px] bg-gradient-to-br from-auroraCyan/30 via-transparent to-auroraViolet/30 shadow-[0_0_80px_rgba(34,211,238,0.15)]">
            <div className="rounded-[31px] bg-abyss/90 backdrop-blur-2xl border border-white/10 overflow-hidden">
                <div className="px-5 py-4 flex items-center justify-between border-b border-white/10">
                    <div className="flex items-center gap-3">
                        <div className="w-8 h-8 rounded-xl bg-gradient-to-br from-auroraCyan to-auroraBlue grid place-items-center">🛰️</div>
                        <div>
                            <div className="font-display font-black text-[11px] tracking-[0.25em] text-auroraCyan">OBSERVATÓRIO AUTOMATIZADO</div>
                            <div className="text-[10px] text-white/40 tracking-widest">PROTOCOLO CIDADÃO SENSOR • ONLINE</div>
                        </div>
                    </div>
                    <div className="text-[9px] px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300">● {lastCheck}</div>
                </div>
                <div className="p-4">
                    <div className="font-display font-black text-[11px] text-center tracking-[0.3em] text-auroraCyan mb-3">🚨 CANAIS DE EMERGÊNCIA & CONTATOS ÚTEIS</div>
                    <div className="flex gap-2.5 overflow-x-auto pb-1 scrollbar-hide">
                        <a href="tel:199" className="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-void/85 border border-auroraCyan/40 btn-neo"><span className="font-display font-black text-base text-auroraCyan">199</span><span className="text-[9px] font-black text-slate-300">DEFESA CIVIL</span></a>
                        <a href="tel:193" className="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-void/85 border border-alertRed/40 btn-neo"><span className="font-display font-black text-base text-alertRed">193</span><span className="text-[9px] font-black text-slate-300">BOMBEIROS</span></a>
                        <a href="tel:192" className="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-void/85 border border-auroraMint/40 btn-neo"><span className="font-display font-black text-base text-auroraMint">192</span><span className="text-[9px] font-black text-slate-300">SAMU</span></a>
                        <a href="tel:188" className="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-void/85 border border-auroraViolet/40 btn-neo"><span className="font-display font-black text-base text-auroraViolet">188</span><span className="text-[9px] font-black text-slate-300">CVV</span></a>
                        {/* CORRIGIDO - SÓ (21) 4040-1772 SEM TEXTO */}
                        <a href="tel:2140401772" className="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-void/85 border border-alertRed/40 btn-neo shadow-[0_0_18px_rgba(251,113,133,0.25)]"><span className="font-display font-black text-base text-alertRed">199</span><span className="text-[9px] font-black text-slate-300 tracking-wider">(21) 4040-1772</span></a>
                        <a href="tel:21972993223" className="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-void/85 border border-auroraMint/40 btn-neo"><span className="text-[9px] font-black text-slate-300">📲 ZAP ALERTAS (21) 97299-3223</span></a>
                    </div>
                </div>
            </div>
        </div>
    )
}

// === VISTORIA COM FOTO + LAUDO + MAPS + WHATSAPP SEM ESTOURAR ===
function SurveyWidget() {
    const [photo, setPhoto] = React.useState(null);
    const [photoFile, setPhotoFile] = React.useState(null);
    const [latLng, setLatLng] = React.useState(null);
    const [loading, setLoading] = React.useState(false);
    const [form, setForm] = React.useState({ tipo:"Risco de deslizamento", gravidade:"Médio", descricao:"" });

    React.useEffect(() => {
        navigator.geolocation?.getCurrentPosition(p => setLatLng(`${p.coords.latitude.toFixed(6)},${p.coords.longitude.toFixed(6)}`), ()=>{}, {enableHighAccuracy:true});
    }, []);

    const handlePhoto = async (e) => {
        const file = e.target.files[0]; if(!file) return;
        setLoading(true);
        const img = new Image(); img.src = URL.createObjectURL(file);
        await new Promise(r => img.onload = r);
        const canvas = document.createElement('canvas');
        const max = 1024; let w = img.width, h = img.height;
        if(w > max || h > max){ if(w > h){ h = h * max / w; w = max; } else { w = w * max / h; h = max; } }
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        const base64 = canvas.toDataURL('image/jpeg', 0.7);
        const blob = await (await fetch(base64)).blob();
        const cFile = new File([blob], `vistoria_${Date.now()}.jpg`, {type:'image/jpeg'});
        setPhoto(base64); setPhotoFile(cFile); setLoading(false);
    };

    const gerarRelatorio = () => {
        const protocolo = `CS-${Math.random().toString(36).toUpperCase().slice(2,6)}`;
        const mapsLink = latLng? `https://www.google.com/maps?q=${latLng}` : 'GPS não capturado';
        const texto = `🚨 RELATÓRIO DE CAMPO - DEFESA CIVIL\nProtocolo: ${protocolo}\nTipo: ${form.tipo}\nGravidade: ${form.gravidade}\nLocalização: ${latLng || '...'}\nMaps: ${mapsLink}\nDescrição: ${form.descricao || 'Sem descrição'}\n---\nEnviado via SARAH IA NEXUS v7 OMEGA`;
        return { texto, mapsLink, protocolo };
    };

    const enviarWhatsApp = async () => {
        if(!photoFile){ alert('Tira a foto primeiro, mestre!'); return; }
        const { texto } = gerarRelatorio();
        const zapNumero = '5521972993223';
        if(navigator.canShare && navigator.canShare({ files:[photoFile] })){
            try { await navigator.share({ title:'Vistoria Defesa Civil', text:texto, files:[photoFile] }); return; } catch {}
        }
        const a = document.createElement('a'); a.href = photo; a.download = `vistoria_${Date.now()}.jpg`; a.click();
        window.open(`https://wa.me/${zapNumero}?text=${encodeURIComponent(texto)}`, '_blank');
    };

    const { texto } = gerarRelatorio();

    return (
        <div className="cyber-card rounded-[32px] border border-auroraCyan/20 bg-abyss/80 p-5 space-y-4 shadow-[0_0_60px_rgba(34,211,238,0.1)]">
            <div className="font-display font-black text-[11px] tracking-[0.3em] text-auroraCyan">📸 VISTORIA DE CAMPO - COM FOTO</div>
            <label className="relative flex flex-col items-center justify-center h-44 rounded-2xl border-2 border-dashed border-auroraCyan/30 bg-void/60 hover:bg-void/80 transition cursor-pointer overflow-hidden">
                {photo? <img src={photo} className="absolute inset-0 w-full h-full object-cover" /> : <><div className="text-3xl">📷</div><div className="mt-2 font-black text-[11px] text-auroraCyan tracking-widest">TOCAR PARA TIRAR FOTO NO CAMPO</div><div className="text-[9px] text-white/40">Câmera traseira • Compressão automática</div></>}
                <input type="file" accept="image/*" capture="environment" className="hidden" onChange={handlePhoto} />
                {photo && <div className="absolute bottom-2 right-2 px-2 py-1 rounded-full bg-emerald-500 text-black text-[9px] font-black">FOTO OK</div>}
            </label>
            <div className="grid grid-cols-2 gap-3">
                <select value={form.tipo} onChange={e=>setForm({...form,tipo:e.target.value})} className="rounded-xl bg-void border border-white/10 px-3 py-2.5 text-[12px] text-white"><option>Risco de deslizamento</option><option>Alagamento</option><option>Rachadura estrutural</option><option>Queda de árvore</option><option>Outros</option></select>
                <select value={form.gravidade} onChange={e=>setForm({...form,gravidade:e.target.value})} className="rounded-xl bg-void border border-white/10 px-3 py-2.5 text-[12px] text-white"><option>Baixo</option><option>Médio</option><option>Alto</option><option>Crítico</option></select>
            </div>
            <textarea value={form.descricao} onChange={e=>setForm({...form,descricao:e.target.value})} placeholder="Descrição do campo..." className="w-full rounded-xl bg-void border border-white/10 px-3 py-2.5 text-[12px] text-white min-h-[70px]" />
            <div className="rounded-xl bg-black/40 border border-white/10 p-3 flex gap-3">
                {photo && <img src={photo} className="w-16 h-16 rounded-lg object-cover border border-auroraCyan/30" />}
                <div className="flex-1 text-[10px] text-white/60 whitespace-pre-wrap leading-[1.4]">{texto}</div>
            </div>
            <div className="text-[9px] text-white/30">GPS: {latLng || 'Buscando...'} • Foto comprimida p/ não estourar limite do WhatsApp</div>
            <button onClick={enviarWhatsApp} disabled={loading ||!photo} className="w-full h-12 rounded-xl bg-gradient-to-r from-auroraMint to-auroraCyan text-black font-black text-[12px] tracking-widest disabled:opacity-40 btn-neo">{loading? 'COMPRIMINDO...' : '🚀 ENVIAR FOTO + LAUDO WHATSAPP'}</button>
        </div>
    );
}

function App(){
    return(
        <div className="space-y-5">
            <div className="text-center pt-6 pb-2">
                <div className="font-display font-black text-[18px] tracking-[0.3em] text-auroraCyan">SARAH IA NEXUS v7.0 OMEGA</div>
                <div className="text-[10px] text-white/40 tracking-[0.2em]">DEFESA CIVIL COMUNITÁRIA • PROJETO CIDADÃO SENSOR</div>
            </div>
            <AutomatedObservatoryWidget />
            <SurveyWidget />
            <div className="text-center text-[9px] text-white/20 pt-4">Build OMEGA Final • (21) 4040-1772 corrigido • Foto + Laudo OK</div>
        </div>
    )
}

const root = ReactDOM.createRoot(document.getElementById('app'));
root.render(<App />);
</script>
</body>
</html>
